<%- include('header') %>

<div class="admin-box" style="max-width: 600px;">
  <h4>Edit Image</h4>

  <form method="POST" action="/admin/gallery/edit/<%= img._id %>">
    <div class="mb-3">
      <label class="form-label">Current Image</label>
      <img src="<%= img.thumbPath || img.imagePath %>" style="max-width: 100%; max-height: 300px; border-radius: 6px;">
    </div>

    <div class="mb-3">
      <label class="form-label">Branch</label>
      <select name="branch" class="form-select" required>
        <option value="COMMON" <%= img.branch === 'COMMON' ? 'selected' : '' %>>Common</option>
        <% branches.forEach(b => { %>
          <option value="<%= b._id %>" <%= img.branch === String(b._id) ? 'selected' : '' %>>
            <%= b.name_ml %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="mb-3">
      <label class="form-label">Description (Malayalam)</label>
      <textarea name="description_ml" class="form-control" rows="4" maxlength="500"><%= img.description_ml || '' %></textarea>
      <small class="text-muted">Max 500 characters</small>
    </div>

    <div class="mb-3">
      <label class="form-label">Sort Order</label>
      <input type="number" name="sortOrder" class="form-control" value="<%= img.sortOrder || 0 %>" min="0">
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-dark">Save Changes</button>
      <a href="/admin/gallery" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('footer') %>
