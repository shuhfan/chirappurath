<%- include('header') %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>News Management</h2>
    <a href="/admin/news/add" class="btn btn-primary">Add New</a>
  </div>

  <% if (news && news.length > 0) { %>
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th>Title (ML)</th>
            <th>Category</th>
            <th>Date</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% news.forEach(item => { %>
            <tr>
              <td><%= item.title_ml %></td>
              <td>
                <span class="badge bg-<%= item.category === 'news' ? 'info' : item.category === 'event' ? 'success' : item.category === 'announcement' ? 'warning' : 'secondary' %>">
                  <%= item.category %>
                </span>
              </td>
              <td><%= new Date(item.date).toLocaleDateString('en-GB') %></td>
              <td>
                <span class="badge bg-<%= item.status === 'published' ? 'success' : 'secondary' %>">
                  <%= item.status %>
                </span>
              </td>
              <td>
                <a href="/news/<%= item._id %>" class="btn btn-sm btn-info" target="_blank">View</a>
                <a href="/admin/news/edit/<%= item._id %>" class="btn btn-sm btn-warning">Edit</a>
                <form action="/admin/news/delete/<%= item._id %>" method="POST" style="display: inline;">
                  <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this news?')">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="alert alert-info">
      No news articles found. <a href="/admin/news/add">Create your first one</a>
    </div>
  <% } %>
</div>

<%- include('footer') %>
