
<!-- ===== FATHERS SECTION ===== -->
<section class="fathers-section">
  <div class="container">
    <h2 class="fathers-heading text-center"><%= t('faith_leadership') %></h2>
    <div class="about-divider mx-auto"></div>

    <div class="row">
      <!-- Father 1: John -->
      <div class="col-lg-3 col-md-6 mb-5">
        <div class="father-card">
          <div class="father-image">
            <img src="/images/john.jpeg" alt="Rev. C.V. John Kashisha">
          </div>
          <div class="father-details">
            <div class="father-name">Rev. C.V. John Kashisha</div>
            <div class="father-info"><%= t('chirappurath') %></div>
            <div class="father-info">
              <strong><%= t('born') %>:</strong> 10 <%= t('april') %> 1909
            </div>
            <div class="father-info">
              <strong><%= t('died') %>:</strong> 2 <%= t('september') %> 1979
            </div>
            
          </div>
        </div>
      </div>

      <!-- Father 2: Jacob -->
      <div class="col-lg-3 col-md-6 mb-5">
        <div class="father-card">
          <div class="father-image">
            <img src="/images/jacob.jpeg" alt="Rev. Fr. Jacob Thomas">
          </div>
          <div class="father-details">
            <div class="father-name">Rev. Fr. Jacob Thomas</div>
            <div class="father-info">(രക്ഷാധികാരി)</div>
            <div class="father-info"><%= t('thanukkumpathiykkol') %></div>
          </div>
        </div>
      </div>

      <!-- Father 3: Binu -->
      <div class="col-lg-3 col-md-6 mb-5">
        <div class="father-card">
          <div class="father-image">
            <img src="/images/binu.jpeg" alt="Rev. Fr. Binu Joseph">
          </div>
          <div class="father-details">
            <div class="father-name">Rev. Fr. Binu Joseph</div>
            <div class="father-info">(രക്ഷാധികാരി)</div>
            <div class="father-info"><%= t('thanukkumpathiykkol') %></div>
          </div>
        </div>
      </div>

      <!-- Father 4: Ramban -->
      <div class="col-lg-3 col-md-6 mb-5">
        <div class="father-card">
          <div class="father-image">
            <img src="/images/ramban.jpeg" alt="Very. Rev. Aprem Ramban">
          </div>
          <div class="father-details">
            <div class="father-name">Very. Rev. Aprem Ramban</div>
            <div class="father-info">(രക്ഷാധികാരി)</div>
            <div class="father-info"><%= t('chirathalaykkol') %></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* Priest Gallery Card Layout Fix */
.fathers-section {
  padding: 60px 0;
  background: #f7f3ee;
}

.fathers-heading {
  font-family: 'Noto Serif Malayalam', serif;
  font-size: 42px;
  font-weight: 700;
  color: #512626;
  margin-bottom: 20px;
}

.father-card {
  background: #fff;
  border: 1px solid #e6d9c3;
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.5s ease;
  box-shadow: 0 8px 25px rgba(0,0,0,0.08);
  height: 100%;
  display: flex;
  flex-direction: column;
}

.father-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 20px 50px rgba(0,0,0,0.15);
  border-color: #d4af37;
}

.father-image {
  width: 100%;
  height: 350px;
  overflow: hidden;
  position: relative;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.father-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  transition: transform 0.6s ease;
}

.father-card:hover .father-image img {
  transform: scale(1.08);
}

.father-details {
  padding: 25px 20px;
  text-align: center;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.father-name {
  font-family: 'Playfair Display', serif;
  font-size: 18px;
  font-weight: 700;
  color: #512626;
  margin-bottom: 15px;
  line-height: 1.3;
}

.father-info {
  font-family: 'Noto Serif Malayalam', serif;
  font-size: 14px;
  color: #555;
  margin-bottom: 8px;
  line-height: 1.6;
}

.father-info strong {
  color: #d4af37;
  font-weight: 600;
}

/* Mobile responsive */
@media (max-width: 768px) {
  .fathers-heading {
    font-size: 32px;
  }

  .father-image {
    height: 400px;
  }

  .father-card {
    margin-bottom: 30px;
  }

  .father-name {
    font-size: 16px;
  }

  .father-info {
    font-size: 13px;
  }
}

@media (min-width: 769px) and (max-width: 991px) {
  .father-image {
    height: 300px;
  }

  .father-name {
    font-size: 16px;
  }
}
</style>
