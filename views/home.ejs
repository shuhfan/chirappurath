  </div>
</section>





<!-- CONFETTI -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<script>
(function () {
  // If already inaugurated, hide overlay
  if (localStorage.getItem("inaugurated") === "true") {
    const overlay = document.getElementById("ribbonOverlay");
    if (overlay) overlay.remove();
  }
})();

function cutRibbon() {
  document.querySelector(".fullscreen-ribbon").classList.add("cut");

  // Confetti
  let end = Date.now() + 2500;
  (function frame() {
    confetti({
      particleCount: 8,
      spread: 100,
      origin: { y: 0.6 }
    });
    if (Date.now() < end) requestAnimationFrame(frame);
  })();

  // Save state & remove overlay
  setTimeout(() => {
    localStorage.setItem("inaugurated", "true");
    document.getElementById("ribbonOverlay").remove();
  }, 1200);
}
</script>

