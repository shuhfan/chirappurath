<div id="ribbonOverlay">
  <div class="inauguration-container">

    <!-- Elegant Curtains -->
    <div class="curtain-wrapper">
      <div class="curtain curtain-left"></div>
      <div class="curtain curtain-right"></div>
    </div>

    <!-- Center Content -->
    <div class="inauguration-content">

      <!-- Family Logo -->
      <div class="inauguration-logo">
        <img src="/images/logo.png" alt="Chirappurath Family">
      </div>

      <!-- Title -->
      <h1 class="inauguration-title">CHIRAPPURATH FAMILY</h1>

      <!-- Decorative Line -->
      <div class="inauguration-divider">
        <span class="divider-ornament">✦</span>
      </div>

      <!-- Subtitle -->
      <p class="inauguration-subtitle">90 Years of Heritage • Since 1936</p>

      <!-- Inaugurate Button -->
      <button class="btn-inaugurate" onclick="inaugurateWebsite()">
        <span class="btn-text">Inaugurate</span>
        <span class="btn-icon">→</span>
      </button>

    </div>

  </div>
</div>


