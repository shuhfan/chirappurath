<!-- CONFETTI -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<script>
(function () {
  // If already inaugurated, hide overlay and allow scrolling
  if (localStorage.getItem("inaugurated") === "true") {
    const overlay = document.getElementById("ribbonOverlay");
    if (overlay) overlay.remove();
  } else {
    // Lock body scroll when inauguration overlay is visible
    document.body.style.overflow = "hidden";
    document.body.style.height = "100vh";
  }
})();

function inaugurateWebsite() {
  // Add opening class to curtains
  document.querySelector(".curtain-wrapper").classList.add("opening");

  // Fade out the content
  document.querySelector(".inauguration-content").style.opacity = "0";

  // Confetti celebration
  setTimeout(() => {
    let end = Date.now() + 3000;
    (function frame() {
      confetti({
        particleCount: 5,
        angle: 60,
        spread: 55,
        origin: { x: 0, y: 0.6 }
      });
      confetti({
        particleCount: 5,
        angle: 120,
        spread: 55,
        origin: { x: 1, y: 0.6 }
      });
      if (Date.now() < end) requestAnimationFrame(frame);
    })();
  }, 600);

  // Save state & remove overlay
  setTimeout(() => {
    localStorage.setItem("inaugurated", "true");
    document.getElementById("ribbonOverlay").remove();

    // Unlock body scroll after inauguration
    document.body.style.overflow = "auto";
    document.body.style.height = "auto";
  }, 1800);
}
</script>

