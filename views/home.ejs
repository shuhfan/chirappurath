<div id="ribbonOverlay">
  <div class="overlay-content">

    <div class="fullscreen-ribbon">
      <div class="ribbon-half left"></div>
      <div class="ribbon-half right"></div>
    </div>

    <button class="btn-heritage mt-4" onclick="cutRibbon()">
      Inaugurate
    </button>

  </div>
</div>


<section class="hero">
  <div class="hero-box">

    <!-- LOGO -->
    <img src="/images/logo.png" class="hero-logo" alt="Chirappurath Family">

    <!-- TITLE -->
    <h1 class="hero-title">CHIRAPPURATH FAMILY</h1>

    <div class="hero-line"></div>

    <!-- SUB TITLE -->
    <div class="hero-sub">
      <%= t('hero_subtitle') %>
    </div>

    
  </div>
</section>



<!-- ===== MARQUEE SECTION ===== -->
<section class="marquee-section">
  <div class="marquee-container">
    <div class="marquee-content">
      <span><%= t('marquee_text') %></span>
      <span><%= t('marquee_text') %></span>
      <span><%= t('marquee_text') %></span>
      <span><%= t('marquee_text') %></span>
    </div>
  </div>
</section>


<!-- ===== FAMILY HISTORY SECTION WITH NEWS ===== -->
<section class="history-section">
  <div class="container">
    <h2 class="history-title text-center"><%= t('family_history') %></h2>

    <div class="row">
      <!-- Left Column: Family History -->
      <div class="col-lg-8">
        <div class="history-content">
          <p><%= t('history_para1') %></p>
          <p><%= t('history_para2') %></p>
          <p><%= t('history_para3') %></p>
          <p><%= t('history_para4') %></p>
          <p><%= t('history_para5') %></p>
        </div>
      </div>

      <!-- Right Column: News/Events -->
      <div class="col-lg-4">
        <div class="news-sidebar">
          <h3 class="news-sidebar-title"><%= t('news_events') %></h3>

          <% if (recentNews && recentNews.length > 0) { %>
            <div class="news-list">
              <% recentNews.forEach(news => { %>
                <div class="news-item">
                  <a href="/news/<%= news._id %>" class="news-link">
                    <h4 class="news-item-title">
                      <%= lang === 'en' ? (news.title_en || news.title_ml) : news.title_ml %>
                    </h4>
                    <p class="news-item-date">
                      <%= new Date(news.date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).replace(/ /g, '-') %>
                    </p>
                    <p class="news-item-excerpt">
                      <%= lang === 'en' ? (news.excerpt_en || news.excerpt_ml) : news.excerpt_ml %>
                    </p>
                    <span class="news-read-more"><%= t('read_more') %></span>
                  </a>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="no-news">
              <p class="text-muted"><%= t('no_news') %></p>
            </div>
          <% } %>

          <div class="text-center mt-4">
            <a href="/news" class="btn btn-heritage"><%= t('view_all_news') %></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>





<section class="branches-section">
  <div class="container">

    <h2 class="section-heading text-center">
      <%= t('family_branches') %>
    </h2>
    <div class="about-divider"></div>

    <div class="row">
      <!-- Kuzhimattam Branch -->
      <div class="col-lg-6">
        <div class="branch-main-heading"><%= t('kuzhimattam_branch') %></div>
        <div class="branch-list">
          <% const kuzhimattamBranches = [
            'naduvileddam',
            'karanikulam',
            'kizhakkekkurt',
            'chelachira',
            'valyavettil'
          ]; %>

          <% kuzhimattamBranches.forEach((name, index) => { %>
            <div class="branch-item">
              <span class="branch-number"><%= index + 1 %></span>
              <span class="branch-name"><%= t(name) %></span>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Thottaykkad Branch -->
      <div class="col-lg-6">
        <div class="branch-main-heading"><%= t('thottaykkad_branch') %></div>
        <div class="branch-list">
          <% const thotaykkadBranches = [
            'thanukkumpathiykkol',
            'kizhakkemuriyil',
            'chirathalaykkol',
            'mattathil',
            'thanukkumpathiykkol_east',
            'thanukkumpathiykkol_west',
            'chirappurath'
          ]; %>

          <% thotaykkadBranches.forEach((name, index) => { %>
            <div class="branch-item">
              <span class="branch-number"><%= index + 6 %></span>
              <span class="branch-name"><%= t(name) %></span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>





<!-- CONFETTI -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<script>
(function () {
  // If already inaugurated, hide overlay
  if (localStorage.getItem("inaugurated") === "true") {
    const overlay = document.getElementById("ribbonOverlay");
    if (overlay) overlay.remove();
  }
})();

function cutRibbon() {
  document.querySelector(".fullscreen-ribbon").classList.add("cut");

  // Confetti
  let end = Date.now() + 2500;
  (function frame() {
    confetti({
      particleCount: 8,
      spread: 100,
      origin: { y: 0.6 }
    });
    if (Date.now() < end) requestAnimationFrame(frame);
  })();

  // Save state & remove overlay
  setTimeout(() => {
    localStorage.setItem("inaugurated", "true");
    document.getElementById("ribbonOverlay").remove();
  }, 1200);
}
</script>

