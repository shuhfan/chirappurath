<section class="hero">
  <img src="/images/banner.jpg" class="hero-banner" alt="Chirappurath Kudumbayogam">
</section>



<!-- ===== MARQUEE SECTION ===== -->
<section class="marquee-section">
  <div class="marquee-container">
    <div class="marquee-content">
      <span><%= t('marquee_text') %></span>
      <span><%= t('marquee_text') %></span>
      <span><%= t('marquee_text') %></span>
      <span><%= t('marquee_text') %></span>
    </div>
  </div>
</section>


<!-- ===== FAMILY HISTORY SECTION WITH NEWS ===== -->
<section class="history-section">
  <div class="container">
    <h2 class="history-title"><%- t('family_history_title') %></h2>

    <div class="row g-3">
      <!-- Left Column: Family History -->
      <div class="col-lg-8">
        <div class="history-content">
          <p><%= t('history_para1') %></p>
          <p><%= t('history_para2') %></p>
          <p><%= t('history_para3') %></p>
          <p><%= t('history_para4') %></p>
          <p><%= t('history_para5') %></p>
        </div>
      </div>

      <!-- Right Column: News/Events -->
      <div class="col-lg-4">
        <div class="news-sidebar">
          <h3 class="news-sidebar-title"><%= t('news_events') %></h3>

          <div class="news-list">
            <div class="news-item">
              <h4 class="news-item-title"><%= t('event_title') %></h4>
              <p class="news-item-excerpt"><%= t('event_venue_label') %> : <%= t('event_venue') %></p>
              <p class="news-item-excerpt"><%= t('event_date_label') %> : <%- t('event_date') %></p>

              <h5 class="news-item-subtitle"><%= t('event_chairman_label') %></h5>
              <p class="news-item-excerpt"><%= t('event_chairman') %></p>

              <h5 class="news-item-subtitle"><%= t('event_inauguration_label') %></h5>
              <p class="news-item-excerpt"><%= t('event_inauguration') %></p>

              <h5 class="news-item-subtitle"><%= t('event_blessing_label') %></h5>
              <p class="news-item-excerpt"><%= t('event_blessing') %></p>

              <h5 class="news-item-subtitle"><%= t('event_wishes_label') %></h5>
              <p class="news-item-excerpt"><%= t('event_wishes_1') %></p>
              <p class="news-item-excerpt"><%= t('event_wishes_2') %></p>
              <p class="news-item-excerpt"><%= t('event_wishes_3') %></p>

              <h5 class="news-item-subtitle"><%= t('event_website_label') %></h5>
              <p class="news-item-excerpt"><%= t('event_website') %></p>

              <h5 class="news-item-subtitle"><%= t('event_recognition_label') %></h5>
              <p class="news-item-excerpt"><%= t('event_recognition_1') %></p>
              <p class="news-item-excerpt"><%= t('event_recognition_2') %></p>
              <h5 class="news-item-subtitle"><%= t('event_recognition_3') %></h5>
              <h5 class="news-item-subtitle"><%= t('event_recognition_4') %></h5>
            </div>
          </div>

          <!-- <div class="text-center mt-4">
            <a href="/news" class="btn btn-heritage"><%= t('view_all_news') %></a>
          </div> -->
        </div>
      </div>
    </div>
  </div>
</section>





<section class="branches-section">
  <div class="container">

    <h2 class="section-heading text-center">
      <%= t('family_branches') %>
    </h2>
    <div class="about-divider"></div>

    <div class="row">
      <!-- Kuzhimattam Branch -->
      <div class="col-lg-6">
        <div class="branch-main-heading"><%= t('kuzhimattam_branch') %></div>
        <div class="branch-list">
          <% const kuzhimattamBranches = [
            'naduvileddam',
            'karanikulam',
            'kizhakkekkurt',
            'chelachira',
            'valyavettil'
          ]; %>

          <% kuzhimattamBranches.forEach((name, index) => { %>
            <div class="branch-item">
              <span class="branch-name"><%= t(name) %></span>
            </div>
          <% }) %>
          <div class="branch-item branch-item-dummy branch-name">⭐⭐⭐</div>
          <div class="branch-item branch-item-dummy branch-name">⭐⭐⭐</div>
        </div>
      </div>

      <!-- thottakad Branch -->
      <div class="col-lg-6">
        <div class="branch-main-heading"><%= t('thottaykkad_branch') %></div>
        <div class="branch-list">
          <% const thotaykkadBranches = [
            'thanukkumpathiykkol',
            'kizhakkemuriyil',
            'chirathalaykkol',
            'mattathil',
            'thanukkumpathiykkol_east',
            'thanukkumpathiykkol_west',
            'chirappurath'
          ]; %>

          <% thotaykkadBranches.forEach((name, index) => { %>
            <div class="branch-item">
              <!-- <span class="branch-number"><%= index + 6 %></span> -->
              <span class="branch-name"><%= t(name) %></span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</section>







